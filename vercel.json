{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://pplp.click/api/:path*" },
    { "source": "/hubs/:path*", "destination": "https://pplp.click/hubs/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "github": {
    "enabled": true
  }
}